PORT=8080
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms?sslmode=disable
# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:3000
# development | production (production refuses a weak JWT_SECRET)
APP_ENV=development
# First HR admin when SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true loads the 16 SIBK staff and sample data into an empty database
SEED_DEMO=true
