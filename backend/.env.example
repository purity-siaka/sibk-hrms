PORT=8080
DATABASE_URL=postgres://hrms:hrms@localhost:5432/hrms?sslmode=disable
# At least 32 random characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
UPLOAD_DIR=./uploads
# Optional. Uses Google Application Default Credentials when set.
GCS_BUCKET=
CORS_ORIGIN=http://localhost:3000
# development | production (production refuses a weak JWT_SECRET)
APP_ENV=development
# First HR admin when SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true loads the 16 SIBK staff and sample data into an empty database
SEED_DEMO=true

# Email. Leave SMTP_HOST empty to disable (emails are then only written to the log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# plain, or login for some Microsoft 365 setups
SMTP_AUTH=plain
MAIL_FROM=
MAIL_FROM_NAME=IT Department
# Every leave request is copied to this mailbox. Carol handles it, including for staff without an email.
HR_MAILBOX=hr@salaaminvestments.com
